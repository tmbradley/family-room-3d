{
  "name": "house-planner",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "setup-code": "tsx scripts/create-setup-code.ts",
    "agent-key": "tsx scripts/create-agent-key.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:predeploy": "tsx scripts/predeploy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "^13.3.3",
    "hono": "^4.13.13",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  }
}
